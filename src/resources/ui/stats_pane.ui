<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!--// StatsPane template //-->
  <template class="StatsPane" parent="GtkBox">
    <style>
      <class name="card"/>
    </style>
    <child>
      <object class="GtkBox">
        <property name="margin-start">24</property>
        <property name="margin-end">24</property>
        <property name="margin-top">20</property>
        <property name="margin-bottom">20</property>
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkBox">
            <property name="margin-bottom">4</property>
            <property name="spacing">16</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">stats-symbolic</property>
                <style>
                  <class name="bubble"/>
                  <class name="accent"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="xalign">0</property>
                <property name="label">Statistics</property>
                <style>
                  <class name="title-3"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkGrid">
            <property name="hexpand">true</property>
            <property name="row-spacing">8</property>
            <property name="column-spacing">28</property>
            <child>
              <object class="GtkLabel">
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                </layout>
                <property name="xalign">0</property>
                <property name="label">Source Files</property>
                <style>
                  <class name="caption-heading"/>
                  <class name="dimmed"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="source_files_label">
                <layout>
                  <property name="row">0</property>
                  <property name="column">1</property>
                </layout>
                <property name="xalign">1</property>
                <style>
                  <class name="numeric"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <layout>
                  <property name="row">1</property>
                  <property name="column">0</property>
                </layout>
                <property name="xalign">0</property>
                <property name="label">Created</property>
                <style>
                  <class name="caption-heading"/>
                  <class name="dimmed"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="created_files_label">
                <layout>
                  <property name="row">1</property>
                  <property name="column">1</property>
                </layout>
                <property name="xalign">1</property>
                <style>
                  <class name="numeric"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <layout>
                  <property name="row">2</property>
                  <property name="column">0</property>
                </layout>
                <property name="xalign">0</property>
                <property name="label">Transferred</property>
                <style>
                  <class name="caption-heading"/>
                  <class name="dimmed"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="transferred_files_label">
                <layout>
                  <property name="row">2</property>
                  <property name="column">1</property>
                </layout>
                <property name="xalign">1</property>
                <style>
                  <class name="numeric"/>
                </style>
              </object>
            </child> 
            <child>
              <object class="GtkLabel">
                <layout>
                  <property name="row">3</property>
                  <property name="column">0</property>
                </layout>
                <property name="xalign">0</property>
                <property name="label">Deleted</property>
                <style>
                  <class name="caption-heading"/>
                  <class name="dimmed"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="deleted_files_label">
                <layout>
                  <property name="row">3</property>
                  <property name="column">1</property>
                </layout>
                <property name="xalign">1</property>
                <style>
                  <class name="numeric"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkSeparator">
                <layout>
                  <property name="row">0</property>
                  <property name="column">2</property>
                  <property name="row-span">4</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <layout>
                  <property name="row">0</property>
                  <property name="column">3</property>
                </layout>
                <property name="xalign">0</property>
                <property name="label">File Size</property>
                <style>
                  <class name="caption-heading"/>
                  <class name="dimmed"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="source_size_label">
                <layout>
                  <property name="row">0</property>
                  <property name="column">4</property>
                </layout>
                <property name="xalign">1</property>
                <style>
                  <class name="numeric"/>
                </style>
              </object>
            </child> 
            <child>
              <object class="GtkLabel">
                <layout>
                  <property name="row">1</property>
                  <property name="column">3</property>
                </layout>
                <property name="xalign">0</property>
                <property name="label">Transfer Size</property>
                <style>
                  <class name="caption-heading"/>
                  <class name="dimmed"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="transferred_size_label">
                <layout>
                  <property name="row">1</property>
                  <property name="column">4</property>
                </layout>
                <property name="xalign">1</property>
                <style>
                  <class name="numeric"/>
                </style>
              </object>
            </child> 
            <child>
              <object class="GtkLabel">
                <layout>
                  <property name="row">2</property>
                  <property name="column">3</property>
                </layout>
                <property name="xalign">0</property>
                <property name="label">Bytes Sent</property>
                <style>
                  <class name="caption-heading"/>
                  <class name="dimmed"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="sent_bytes_label">
                <layout>
                  <property name="row">2</property>
                  <property name="column">4</property>
                </layout>
                <property name="xalign">1</property>
                <style>
                  <class name="numeric"/>
                </style>
              </object>
            </child> 
            <child>
              <object class="GtkLabel">
                <layout>
                  <property name="row">3</property>
                  <property name="column">3</property>
                </layout>
                <property name="xalign">0</property>
                <property name="label">Bytes Received</property>
                <style>
                  <class name="caption-heading"/>
                  <class name="dimmed"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="received_bytes_label">
                <layout>
                  <property name="row">3</property>
                  <property name="column">4</property>
                </layout>
                <property name="xalign">1</property>
                <style>
                  <class name="numeric"/>
                </style>
              </object>
            </child> 
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
